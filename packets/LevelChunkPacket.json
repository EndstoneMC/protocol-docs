{
  "id": 58,
  "name": "LevelChunkPacket",
  "notes": "Used to start a chunk transaction.",
  "fields": [
    {
      "name": "Chunk Position",
      "type": "ChunkPos"
    },
    {
      "name": "Dimension Id",
      "type": "DimensionType"
    },
    {
      "name": "Sub-chunks Count",
      "type": "uvarint32",
      "constraints": {
        "maximum": 64
      }
    },
    {
      "name": "Client Request SubChunk Limit",
      "type": "varint32",
      "constraints": {
        "minimum": -1,
        "maximum": 64
      },
      "optional": true
    },
    {
      "name": "Cache Enabled",
      "type": "bool"
    },
    {
      "name": "Cache Metadata",
      "type": "LevelChunkPacketPayload::SubChunkMetadata",
      "repeat": {
        "prefix": "uvarint32"
      },
      "constraints": {
        "max_items": 65
      }
    },
    {
      "name": "Serialized Chunk Data",
      "type": "string"
    }
  ]
}