{
  "id": 366,
  "name": "VirtualContainerOpenPacket",
  "notes": "Includes all initial slots and their server net IDs. The number of slots determines the container size.",
  "fields": [
    {
      "name": "Container Id",
      "type": "uint8"
    },
    {
      "name": "Session Id",
      "type": "uvarint64",
      "constraints": {
        "minimum": 1
      }
    },
    {
      "name": "Title",
      "type": "string",
      "constraints": {
        "max_length": 256
      }
    },
    {
      "name": "Slots",
      "type": "cerealizer<NetworkItemStackDescriptor>::SerializedData",
      "repeat": "uvarint32",
      "constraints": {
        "min_items": 1,
        "max_items": 54
      }
    }
  ]
}