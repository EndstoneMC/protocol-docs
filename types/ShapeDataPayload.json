{
  "name": "ShapeDataPayload",
  "fields": [
    {
      "name": "NetworkId",
      "type": "uint64"
    },
    {
      "name": "Shape Type",
      "type": "string",
      "enum": "ScriptModuleDebugUtilities::ScriptDebugShapeType",
      "optional": true
    },
    {
      "name": "Location",
      "type": "Vec3",
      "optional": true
    },
    {
      "name": "Scale",
      "type": "float",
      "optional": true
    },
    {
      "name": "Rotation",
      "type": "Vec3",
      "optional": true
    },
    {
      "name": "Total Time Left",
      "type": "float",
      "optional": true
    },
    {
      "name": "Color",
      "type": "mce::Color",
      "optional": true
    },
    {
      "name": "Dimension ID",
      "type": "AutomaticID<Dimension, int>",
      "optional": true
    },
    {
      "name": "Extra Shape Data",
      "type": {
        "switch": {
          "type": "uvarint32"
        },
        "cases": [
          null,
          "ArrowDataPayload",
          "TextDataPayload",
          "BoxDataPayload",
          "LineDataPayload",
          "SphereDataPayload"
        ]
      }
    }
  ]
}