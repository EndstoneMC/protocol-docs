        "cases": [
          "EAS::BoolAttributeData",
          "EAS::FloatAttributeData",
          "EAS::ColorAttributeData"
        ]
      }
    },
    {
      "name": "ToAttribute",
      "type": {
        "switch": "uvarint32",
